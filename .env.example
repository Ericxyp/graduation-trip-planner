# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，绝不要提交真实值。
# 推荐用 `vercel env pull .env.local` 从 Vercel 项目拉取（Neon 集成会自动注入 DATABASE_URL）。

# Neon Postgres 连接串（只在服务端读取，不要加 VITE_ 前缀）
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 令牌哈希的额外密钥（≥16 位随机字符串，例如 `openssl rand -base64 32` 的输出）
# 一旦上线不要更换：更换后所有已发出的成员身份和邀请码都会失效
TOKEN_PEPPER=replace-with-a-long-random-string

# 邀请链接使用的站点域名；不填则使用请求的来源域名（Preview 部署会自动用预览域名）
APP_ORIGIN=https://biye-dazi-ju.vercel.app

# 仅集成测试使用：一次性的本地或 Neon 测试分支（会被清空重建，绝不要指向生产库）
# TEST_DATABASE_URL=postgres://dev:dev@localhost:5432/gradtrip_test
# ALLOW_TEST_DB_RESET=1
